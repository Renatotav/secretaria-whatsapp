   "color": "6"
  },
  {
   "id": "db",
   "type": "text",
   "x": 820,
   "y": 920,
   "width": 340,
   "height": 150,
   "text": "## 🐘 PostgreSQL\nFinanceEntry · AgendaItem · WorkTicket · WorkContact · ScooterLog · AgentConfig…\nBackup diário 03:30 (14 dias).",
   "color": "4"
  },
