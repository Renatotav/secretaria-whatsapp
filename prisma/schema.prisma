generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── MODELOS ORIGINAIS ────────────────────────────────────────────────────────

model AgentConfig {
  id              String   @id @default(cuid())
  name            String   @default("Assistente IA")
  systemPrompt    String   @default("")
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(1024)
  evolutionUrl    String   @default("")
  evolutionApiKey String   @default("")
  instanceId      String   @default("")
  historyLimit    Int      @default(10)
  enabled         Boolean  @default(true)
  allowedPhones   String   @default("")
  aiProvider      String   @default("openai")
  openaiApiKey    String   @default("")
  openaiModel     String   @default("gpt-4.1-mini")
  groqApiKey      String   @default("")
  groqModel       String   @default("llama-3.3-70b-versatile")
  googleApiKey    String   @default("")
  googleModel     String   @default("gemini-2.0-flash")
  openrouterApiKey String  @default("")
  openrouterModel  String  @default("openai/gpt-4o-mini")
  ownerPhone      String   @default("")
  ownerName       String   @default("")
  ownerRole       String   @default("")
  summaryTime     String   @default("18:00")
  weeklyTime      String   @default("20:00")
  reminderHours   Int      @default(3)
  audioEnabled    Boolean  @default(false)
  debounceSeconds Int      @default(8)
  typingMsPerChar Int      @default(35)
  typingMaxSeconds Int     @default(8)
  creditCardDueDay Int     @default(10)
  creditCardBestDay Int    @default(5)
  /// Resumir com a IA cada mensagem privada recebida e avisar o dono (desligado desde 07/10/2026: virou barulho).
  privateBriefings Boolean @default(false)
  /// Ler as conversas privadas só para achar compromissos e sugerir na agenda.
  detectCommitments Boolean @default(true)
  /// Telefones silenciados (separados por vírgula): nunca passam pela IA.
  mutedContacts    String  @default("")
  /// Chave que a extensão "Central do Atendente" usa para mandar chamados.
  workApiToken     String  @default("")
  /// Link do guia/download da extensão (fica no banco, não no repositório público).
  workGuideUrl     String  @default("")
  /// Último mês ("AAAA-MM") cujo resultado já foi aplicado na Reserva (evita tirar duas vezes).
  reserveSyncedMonth String @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conversation {
  id          String    @id @default(cuid())
  source      String    @default("chat")
  phone       String?
  contactName String    @default("")
  nameSource  String    @default("webhook")
  status      String    @default("lead")
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  tokens         Int?
  createdAt      DateTime     @default(now())
}

// ─── MODELOS NOVOS ────────────────────────────────────────────────────────────

model GroupConfig {
  id        String   @id @default(cuid())
  groupJid  String   @unique
  groupName String   @default("")
  focus     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Briefing {
  id          String   @id @default(cuid())
  phone       String
  contactName String   @default("")
  rawMessage  String
  summary     String
  subject     String
  urgency     String   @default("normal")
  receivedAt  DateTime
  notified    Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AgendaItem {
  id           String    @id @default(cuid())
  source       String    @default("group")
  groupJid     String?
  groupName    String    @default("")
  category     String
  title        String
  description  String
  dueDate      DateTime?
  senderName   String    @default("")
  rawMessage   String
  notified     Boolean   @default(false)
  reminded     Boolean   @default(false)
  done         Boolean   @default(false)
  followUpNote String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GroupMessage {
  id         String   @id @default(cuid())
  groupJid   String
  groupName  String   @default("")
  senderName String   @default("")
  content    String
  receivedAt DateTime
  summarized Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model DailySummary {
  id        String    @id @default(cuid())
  groupJid  String
  groupName String    @default("")
  date      String
  summary   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model WeeklyReport {
  id        String    @id @default(cuid())
  weekStart String
  weekEnd   String
  content   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model Ticket {
  id        String   @id @default(cuid())
  ticketId  String
  prefix    String   @default("")
  groupJid  String   @default("")
  groupName String   @default("")
  status    String   @default("open")
  title     String   @default("")
  mentions  String   @default("[]")
  lastSeen  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceEntry {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  category    String   @default("")
  subcategory String   @default("")
  description String   @default("")
  date        DateTime @default(now())
  purchaseDate DateTime?
  paymentMethod String  @default("pix")
  account     String   @default("Principal")
  /// Cartão de outra pessoa/banco (ex: "Santander do Bruno"); vazio = o cartão do dono.
  card        String   @default("")
  status      String   @default("paid")
  mood        String   @default("neutro")
  source      String   @default("dashboard")
  createdAt   DateTime @default(now())
  invoiceItems InvoiceItem[]
}

model Budget {
  id          String   @id @default(cuid())
  month       String   @default("default") // "default" para todo mês ou "2026-08"
  category    String
  subcategory String   @default("")
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavingsGoal {
  id            String   @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  color         String   @default("#7c6dff")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DiaryEntry {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  content   String
  mood      String   @default("")
  source    String   @default("dashboard")
  createdAt DateTime @default(now())
}

model InvoiceItem {
  id             String       @id @default(cuid())
  financeEntryId String
  financeEntry   FinanceEntry @relation(fields: [financeEntryId], references: [id], onDelete: Cascade)
  name           String
  category       String
  amount         Float
  quantity       Float        @default(1)
  unitPrice      Float        @default(0)
  createdAt      DateTime     @default(now())
}

/// Lista de desejos: o que o dono quer comprar; a secretária avisa quando cabe no mês.
model WishItem {
  id            String   @id @default(cuid())
  name          String
  amount        Float
  installments  Int      @default(1)
  paymentMethod String   @default("cartão")
  category      String   @default("Compras")
  /// "wish" (na lista), "bought" (comprou) ou "dropped" (desistiu).
  status        String   @default("wish")
  /// Último mês ("AAAA-MM") em que avisou que cabia — um aviso por mês.
  notifiedMonth String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Chamado do trabalho (Central do Atendente PJe). A descrição é gravada com
/// CPF mascarado (xxx.xxx.xxx-xx) e sem telefone/e-mail; nunca vai para a IA.
model WorkTicket {
  id          String    @id @default(cuid())
  /// Número normalizado: maiúsculo, sem espaços (ex: 2154585, R2428333, S2444441).
  ticketId    String    @unique
  openedAt    DateTime?
  /// "aberto", "pendente", "resolvido" ou "escalado" (virou Redmine).
  status      String    @default("aberto")
  errorType   String    @default("")
  /// "externo", "interno" ou "".
  origin      String    @default("")
  resolution  String    @default("")
  redmine     String    @default("")
  /// Situação do Redmine no escala (ex: "Nova", "Ag. Info.(Impl)", "Resolvida").
  redmineStatus String  @default("")
  description String    @default("")
  /// "painel", "extensao", "whatsapp" ou "escala" (importado do sistema de escala, só leitura).
  source      String    @default("painel")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
