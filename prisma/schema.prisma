generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── MODELOS ORIGINAIS ────────────────────────────────────────────────────────

model AgentConfig {
  id              String   @id @default(cuid())
  name            String   @default("Assistente IA")
  systemPrompt    String   @default("")
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(1024)
  evolutionUrl    String   @default("")
  evolutionApiKey String   @default("")
  instanceId      String   @default("")
  historyLimit    Int      @default(10)
  enabled         Boolean  @default(true)
  allowedPhones   String   @default("")
  aiProvider      String   @default("openai")
  openaiApiKey    String   @default("")
  openaiModel     String   @default("gpt-4.1-mini")
  groqApiKey      String   @default("")
  groqModel       String   @default("llama-3.3-70b-versatile")
  googleApiKey    String   @default("")
  googleModel     String   @default("gemini-2.0-flash")
  openrouterApiKey String  @default("")
  openrouterModel  String  @default("openai/gpt-4o-mini")
  ownerPhone      String   @default("")
  ownerName       String   @default("")
  ownerRole       String   @default("")
  summaryTime     String   @default("18:00")
  weeklyTime      String   @default("20:00")
  reminderHours   Int      @default(3)
  audioEnabled    Boolean  @default(false)
  debounceSeconds Int      @default(8)
  typingMsPerChar Int      @default(35)
  typingMaxSeconds Int     @default(8)
  creditCardDueDay Int     @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  source    String    @default("chat")
  phone     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  tokens         Int?
  createdAt      DateTime     @default(now())
}

// ─── MODELOS NOVOS ────────────────────────────────────────────────────────────

model GroupConfig {
  id        String   @id @default(cuid())
  groupJid  String   @unique
  groupName String   @default("")
  focus     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Briefing {
  id          String   @id @default(cuid())
  phone       String
  contactName String   @default("")
  rawMessage  String
  summary     String
  subject     String
  urgency     String   @default("normal")
  receivedAt  DateTime
  notified    Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AgendaItem {
  id           String    @id @default(cuid())
  source       String    @default("group")
  groupJid     String?
  groupName    String    @default("")
  category     String
  title        String
  description  String
  dueDate      DateTime?
  senderName   String    @default("")
  rawMessage   String
  notified     Boolean   @default(false)
  reminded     Boolean   @default(false)
  done         Boolean   @default(false)
  followUpNote String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GroupMessage {
  id         String   @id @default(cuid())
  groupJid   String
  groupName  String   @default("")
  senderName String   @default("")
  content    String
  receivedAt DateTime
  summarized Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model DailySummary {
  id        String    @id @default(cuid())
  groupJid  String
  groupName String    @default("")
  date      String
  summary   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model WeeklyReport {
  id        String    @id @default(cuid())
  weekStart String
  weekEnd   String
  content   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model Ticket {
  id        String   @id @default(cuid())
  ticketId  String
  prefix    String   @default("")
  groupJid  String   @default("")
  groupName String   @default("")
  status    String   @default("open")
  title     String   @default("")
  mentions  String   @default("[]")
  lastSeen  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceEntry {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  category    String   @default("")
  subcategory String   @default("")
  description String   @default("")
  date        DateTime @default(now())
  purchaseDate DateTime?
  paymentMethod String  @default("pix")
  status      String   @default("paid")
  source      String   @default("dashboard")
  createdAt   DateTime @default(now())
}

model Budget {
  id        String   @id @default(cuid())
  month     String   @default("default") // "default" para todo mês ou "2026-08"
  category  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavingsGoal {
  id            String   @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  color         String   @default("#7c6dff")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DiaryEntry {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  content   String
  mood      String   @default("")
  source    String   @default("dashboard")
  createdAt DateTime @default(now())
}
